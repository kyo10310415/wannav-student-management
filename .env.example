# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database (Render PostgreSQL - automatically set by Render)
DATABASE_URL=postgresql://user:password@host:port/database

# External Database for Lesson Start Date and Duration (別システムのRender PostgreSQL)
EXTERNAL_DATABASE_URL=postgresql://wannav_user:BUFKQLq8tY7g1VEkItmd04cHhrTPe2eq@dpg-d5kbgqvgi27c739nefs0-a.oregon-postgres.render.com/wannav_extension

# Notion API
# If using separate integrations for student and tutor databases:
NOTION_STUDENT_API_TOKEN=your_student_notion_api_token_here
NOTION_TUTOR_API_TOKEN=your_tutor_notion_api_token_here
NOTION_STUDENT_DB_ID=your_student_database_id_here
NOTION_TUTOR_DB_ID=your_tutor_database_id_here

# If using single integration for both databases (legacy):
# NOTION_API_TOKEN=your_notion_api_token_here

# Google Calendar API
# Method 1: Direct calendar access (requires "すべての予定の詳細" permission)
# Calendar IDs will be automatically fetched from Notion tutor emails
# (Optional) You can manually specify calendar IDs if needed:
# GOOGLE_CALENDAR_IDS=calendar_id_1,calendar_id_2,calendar_id_3
# GOOGLE_CALENDAR_ID=single_calendar_id

# Method 2: Google Sheets sync (via GAS - RECOMMENDED if calendar permissions are restricted)
# GAS script syncs calendar data to Google Sheets, app reads from sheets
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Cache spreadsheet for Notion data (for faster loading)
# GAS script syncs Notion data (students, tutors, lesson progress) to this spreadsheet daily
# If not set, falls back to GOOGLE_SHEET_ID
GOOGLE_CACHE_SHEET_ID=your_cache_spreadsheet_id_here

# Google credentials JSON (base64 encoded or path to file)
# Scopes: calendar.readonly and/or spreadsheets.readonly
GOOGLE_CREDENTIALS_JSON=your_google_credentials_json_here

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Reminders (set to 'false' to disable automatic daily reminders)
# Default: true (enabled)
DISCORD_REMINDERS_ENABLED=true

# Server Configuration
PORT=3000
NODE_ENV=production
