# Configure in Render. Never paste secrets into ChatGPT or commit a populated file.
PUBLIC_URL=https://YOUR-MCP-SERVICE.onrender.com
# OAuth storage only. Dedicated role/schema; never uses this URL to read business data.
AUTH_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URI(s) shown by ChatGPT during OAuth setup. Comma separated.
CHATGPT_REDIRECT_URIS=
# Source origins, no path. Each token is unique to one source.
CENTRAL_URL=https://wannav-student-management.onrender.com
CENTRAL_TOKEN=
EXTENSION_URL=https://extended-management.onrender.com
EXTENSION_TOKEN=
EP_URL=https://wannav-ep.onrender.com
EP_TOKEN=
SALES_URL=https://wannav-sales.onrender.com
SALES_TOKEN=
PAYMENT_URL=https://payment-management-ogpb.onrender.com
PAYMENT_TOKEN=

# Explicit setup mode disables every MCP/auth/data request until configured.
SETUP_MODE=false
