# Configure in Render. Never paste secrets into ChatGPT or commit a populated file.
PUBLIC_URL=https://YOUR-MCP-SERVICE.onrender.com
# OAuth storage only. Dedicated role/schema; never uses this URL to read business data.
AUTH_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URI(s) shown by ChatGPT during OAuth setup. Comma separated.
CHATGPT_REDIRECT_URIS=
# Source origins, no path. Each token is unique to one source.
CENTRAL_URL=
CENTRAL_TOKEN=
EXTENSION_URL=
EXTENSION_TOKEN=
EP_URL=
EP_TOKEN=
SALES_URL=
SALES_TOKEN=
PAYMENT_URL=
PAYMENT_TOKEN=
